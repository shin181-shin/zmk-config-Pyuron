#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
    tapping-term-ms = <150>;
};

&lt {
    tapping-term-ms = <150>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        f2 {
            bindings = <&kp F2>;
            key-positions = <13 12>;
        };

        lclk {
            bindings = <&mkp LCLK>;
            key-positions = <11 12>;
        };

        lclk2 {
            bindings = <&mkp LCLK>;
            key-positions = <16 17>;
        };

        rclk {
            bindings = <&mkp RCLK>;
            key-positions = <17 18>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W           &kp E      &kp R         &kp T       &kp Y            &kp U         &kp I       &kp O              &kp P
&kp A             &kp S           &kp D      &kp F         &kp G       &kp H            &kp J         &kp K       &kp L              &kp ENTER
&mt LEFT_SHIFT Z  &mt LEFT_ALT X  &kp C      &kp V         &kp B       &mkp LCLK        &lt 3 DELETE  &kp N       &kp M              &kp COMMA
&kp DOT           &kp SLASH       &kp LCTRL  &kp LEFT_WIN  &lt 2 INT5  &lt 1 BACKSPACE  &lt 1 SPACE   &lt 2 INT4  &kp RIGHT_CONTROL  &kp DEL
            >;
        };

        layer_1 {
            bindings = <
&kp F10       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp TAB          &kp PG_UP   &trans     &kp UP_ARROW  &trans     &kp MINUS
&kp LS(INT1)  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans           &kp PG_DN   &kp LEFT   &kp DOWN      &kp RIGHT  &kp SEMICOLON
&kp KP_SLASH  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans           &kp ESCAPE  &trans     &trans        &trans     &trans
&trans        &kp F11          &kp KP_MULTIPLY  &trans           &kp KP_NUMBER_0  &trans      &kp LC(C)  &kp LC(V)     &trans     &kp F12
            >;
        };

        layer_2 {
            bindings = <
&kp LS(N1)       &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)   &kp LS(N8)        &kp LS(N9)         &kp LS(EQUAL)
&kp BACKSPACE    &none       &none       &none       &none       &none       &kp AT_SIGN  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp APOSTROPHE
&none            &none       &none       &none       &none       &none       &trans       &none             &none              &kp LEFT_BRACE
&kp RIGHT_BRACE  &kp QMARK   &trans      &trans      &trans      &trans      &trans       &trans            &trans             &kp PIPE
            >;
        };

        layer_3 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &trans  &kp F7          &kp F8  &kp F9  &kp F10
&none         &none         &none           &none         &none         &trans  &kp F4          &kp F5  &kp F6  &trans
&none         &none         &none           &none         &trans        &trans  &trans          &trans  &kp F1  &kp F2
&kp F3        &trans        &bt BT_CLR_ALL  &trans        &trans        &none   &kp KP_NUMLOCK  &trans  &trans  &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans      &trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans      &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans      &trans  &trans  &trans  &trans        &bootloader   &trans        &trans        &trans
&trans  &bt BT_CLR  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };
    };
};
